# Ignore list for KiCAD Projects
# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
# Netlist files (exported from Eeschema)
*.net
# Autorouter files (exported from Pcbnew)
*.dsn
*.ses
*.zip
# --- KiCad 10 (anadido 2026-10-26) ---
# Archivos de bloqueo que KiCad crea mientras el proyecto esta abierto
*.lck
# Respaldos de KiCad 10: el patron viejo *.sch-bak NO los tapa
*.kicad_sch-bak
*.kicad_dru-bak
# Carpeta de respaldos automaticos de KiCad
*-backups/
# Historial local del editor
.history/

# --- APP-PF (anadido 2026-10-29) ---
# Ruedas de pip: 269 MB, se regeneran con pip download -r requirements.txt
APP-PF/ruedas/
# Modelos de MediaPipe: los baja instalar.ps1
APP-PF/modelos/
# Intermedios de PyInstaller y el portable
APP-PF/dist/
APP-PF/build/
APP-PF/*.zip
# Entorno virtual y caches de Python
APP-PF/.venv/
__pycache__/
*.pyc
.pytest_cache/
# Config local: la IP del broker cambia en cada PC
APP-PF/config.json
